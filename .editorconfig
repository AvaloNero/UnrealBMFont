root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp,cs}]
indent_style = tab
indent_size = 4

[*.{json,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
